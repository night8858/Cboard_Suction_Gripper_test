            "executable": "${workspaceFolder}/build/Debug/Cboard_Suction_Gripper_test.elf",
            "configFiles": [
                "${workspaceFolder}/.vscode/openocd-stlink.cfg"
            ],
            "runToEntryPoint": "main",
            "device": "STM32F407IIHx",
            "preLaunchTask": "CMake Build Debug"
